{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STASH",
  "version": "0.1.0",
  "identifier": "com.stash.desktop",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "STASH — Welcome / Sign in",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://stash.localhost; img-src 'self' asset: data: http://stash.localhost; media-src http://stash.localhost; frame-src http://stash.localhost; object-src 'none'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "STASH",
    "shortDescription": "STASH cloud drive",
    "icon": ["../../../../brand/icons/windows/STASH.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../../../../brand/icons/windows/STASH.ico"
      }
    }
  }
}
